<div class="min-h-screen bg-base-200 px-4 py-8">
  <div class="mx-auto max-w-2xl space-y-6">
    <!-- Identity header -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body items-center text-center relative">
        <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn-ghost btn-sm absolute top-4 right-4" %>
        <div class="avatar">
          <div class="w-32 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
            <img src="<%= @user.avatar_url %>" alt="<%= @user.name %>">
          </div>
        </div>
        <h2 class="card-title mt-4"><%= @user.name %></h2>
        <p class="text-base-content/70"><%= @user.email %></p>
        <div class="badge badge-outline gap-2"><%= @user.provider.split("_").first.capitalize %> account</div>
      </div>
    </div>

    <!-- Account metadata -->
    <div class="stats shadow w-full bg-base-100">
      <div class="stat">
        <div class="stat-title">Member since</div>
        <div class="stat-value text-primary text-xl"><%= humanized_datetime(@user.created_at) %></div>
      </div>
      <div class="stat">
        <div class="stat-title">Last signed in</div>
        <div class="stat-value text-secondary text-xl"><%= humanized_datetime(@user.updated_at) %></div>
      </div>
    </div>

    <!-- Connected accounts -->
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="card-title">Connected Accounts</h3>
        <div class="divider mt-0 mb-2"></div>

        <% if (spotify = @user.spotify_account) %>
          <div class="flex flex-wrap items-center gap-3">
            <div class="badge badge-success gap-2">Spotify connected</div>
            <% if spotify.expired? %>
              <div class="badge badge-warning gap-2">Token expired</div>
            <% else %>
              <div class="badge badge-outline gap-2">Token active</div>
            <% end %>
          </div>

          <div class="text-sm text-base-content/70 mt-2 space-y-1">
            <p>Spotify ID: <span class="font-mono"><%= spotify.uid %></span></p>
            <p>Connected since <%= humanized_datetime(spotify.created_at) %></p>
          </div>

          <% if spotify.scope.present? %>
            <div class="flex flex-wrap gap-2 mt-3">
              <% spotify.scope.split.each do |scope| %>
                <div class="badge badge-ghost badge-sm"><%= scope %></div>
              <% end %>
            </div>
          <% end %>

          <div class="card-actions mt-4">
            <%= button_to "Disconnect Spotify", disconnect_spotify_path, method: :delete, class: "btn btn-outline btn-error btn-sm" %>
            <%= button_to "Create Playlist", spotify_playlists_path, class: "btn btn-primary btn-sm" %>
          </div>

          <div id="created-playlists" class="space-y-2 mt-4"></div>
        <% else %>
          <p class="text-base-content/70">Connect your Spotify account to link it with Musicbuddy.</p>
          <div class="card-actions mt-4">
            <%= button_to "/auth/spotify", data: { turbo: false }, class: "btn btn-success btn-sm" do %>
              Connect Spotify
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @user.spotify_account %>
      <!-- Musicbuddy playlists (deferred load via Turbo Frame + Solid Queue job broadcast) -->
      <%= turbo_stream_from "spotify_musicbuddy_playlists_#{@user.id}" %>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <h3 class="card-title">Your Musicbuddy Playlists</h3>
            <% unless @user.spotify_account.expired? %>
              <%= link_to "Refresh", spotify_playlists_path, data: { turbo_frame: "musicbuddy_playlists" }, class: "btn btn-ghost btn-xs" %>
            <% end %>
          </div>
          <div class="divider mt-0 mb-2"></div>
          <% if @user.spotify_account.expired? %>
            <%= render "spotify_playlists/expired" %>
          <% else %>
            <%= turbo_frame_tag "musicbuddy_playlists", src: spotify_playlists_path do %>
              <div class="flex items-center gap-3 text-base-content/70">
                <span class="loading loading-spinner loading-sm"></span>
                <span>Looking for your Musicbuddy playlists on Spotify...</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
