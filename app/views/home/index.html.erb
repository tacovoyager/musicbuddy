<div class="min-h-screen bg-base-200">
  <!-- DaisyUI Navbar -->
  <div class="navbar bg-base-100 shadow-md px-4 sm:px-8">
    <div class="flex-1">
      <a class="btn btn-ghost text-xl font-bold gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        Musicbuddy
      </a>
    </div>
    <div class="flex-none gap-2">
      <span class="badge badge-accent badge-outline">Rails 8 + DaisyUI</span>
      <button class="btn btn-primary btn-sm">Get Started</button>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <!-- Hero Section -->
    <div class="hero bg-base-100 rounded-box shadow-xl p-6 sm:p-10">
      <div class="hero-content text-center">
        <div class="max-w-md">
          <h1 class="text-4xl font-extrabold text-base-content">Welcome to Musicbuddy</h1>
          <p class="py-4 text-base-content/80">
            Your Rails 8 app is powered by <strong>Tailwind CSS</strong> and <strong>DaisyUI</strong> for fast, clean, and component-driven UI development.
          </p>
          <div class="flex justify-center gap-3">
            <button class="btn btn-primary">Primary Action</button>
            <button class="btn btn-secondary">Secondary Action</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="stats shadow w-full bg-base-100">
      <div class="stat">
        <div class="stat-title">Framework</div>
        <div class="stat-value text-primary">Rails 8.0</div>
        <div class="stat-desc">Propshaft + Importmaps</div>
      </div>
      
      <div class="stat">
        <div class="stat-title">Styling</div>
        <div class="stat-value text-secondary">Tailwind 4</div>
        <div class="stat-desc">Utility-First CSS</div>
      </div>
      
      <div class="stat">
        <div class="stat-title">UI Components</div>
        <div class="stat-value text-accent">DaisyUI 5</div>
        <div class="stat-desc">Semantic component classes</div>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-primary">
            🎵 Playlist Assistant
            <div class="badge badge-secondary">New</div>
          </h2>
          <p>Organize, discover, and collaborate on your music collections with ease.</p>
          <div class="card-actions justify-end mt-4">
            <button class="btn btn-outline btn-sm btn-primary">Explore Features</button>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-secondary">
            ⚡ Fast ERB Rendering
            <div class="badge badge-accent">DaisyUI</div>
          </h2>
          <p>Use clean class names like <code>.btn</code>, <code>.card</code>, and <code>.navbar</code> without heavy markup.</p>
          <div class="card-actions justify-end mt-4">
            <button class="btn btn-outline btn-sm btn-secondary">View Components</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
